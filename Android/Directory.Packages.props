<Project ToolsVersion="15.0">
  <!--
    Versi paket Uno sendiri diatur lewat Uno.Sdk di global.json, bukan di sini.
    Daftar di bawah harus mengikuti versi yang dipakai TLIGDashboard.csproj (WinUI),
    karena kedua proyek mengompilasi file sumber yang sama.
  -->
  <ItemGroup>
    <PackageVersion Include="Markdig" Version="0.38.0" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="MiniExcel" Version="1.34.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
