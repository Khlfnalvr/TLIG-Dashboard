<Page
    x:Class="TLIGDashboard.Views.HeQueueHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Riwayat pemakaian plant HE: percobaan apa saja yang sudah dijalankan
         (dari cache parameter) dan siapa memegang plant kapan (dari log antrian).
         Isinya diisi dari code-behind lewat HeControlService, jadi halaman ini
         sama saja di Server maupun Client. -->

    <Page.Resources>
        <Style x:Key="HistoryStatCard" TargetType="Border">
            <Setter Property="Background"      Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush"     Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
        </Style>
    </Page.Resources>

    <Grid Padding="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0"
                Padding="0,0,0,16"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="TitleText"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.6"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Ekspor CSV untuk lampiran laporan praktikum: yang terekspor
                         persis baris yang sedang tampil di layar. -->
                    <Button x:Name="ExportRunsButton"
                            IsEnabled="False"
                            Click="ExportRuns_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      Glyph="&#xEDE1;" FontSize="13"/>
                            <TextBlock x:Name="ExportRunsText"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportLogButton"
                            IsEnabled="False"
                            Click="ExportLog_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      Glyph="&#xEDE1;" FontSize="13"/>
                            <TextBlock x:Name="ExportLogText"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                      Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock x:Name="RefreshText"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,16,0,0">
            <StackPanel Spacing="18">

                <InfoBar x:Name="UnreachableBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Warning"/>

                <!-- Hasil ekspor: nama file yang tersimpan, atau alasan gagalnya. -->
                <InfoBar x:Name="ExportBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Success"/>

                <!-- ── Ringkasan cache ── -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HistoryStatCard}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatTotalLabel"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock x:Name="StatTotalValue" Text="—"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource HistoryStatCard}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatCompletedLabel"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock x:Name="StatCompletedValue" Text="—"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource HistoryStatCard}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatReusesLabel"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock x:Name="StatReusesValue" Text="—"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource HistoryStatCard}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatLastRunLabel"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock x:Name="StatLastRunValue" Text="—"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Riwayat percobaan ── -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="RunsTitle"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="16,10" CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="2.6*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RunColWhen"     Grid.Column="0" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColUser"     Grid.Column="1" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColParams"   Grid.Column="2" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColDuration" Grid.Column="3" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColStatus"   Grid.Column="4" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColMetrics"  Grid.Column="5" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="RunColReuse"    Grid.Column="6" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                        </Grid>
                    </Border>

                    <ItemsRepeater x:Name="RunsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="2.6*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding When}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding User}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Parameters}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Duration}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="4"
                                                Background="{Binding StatusTint}"
                                                CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10"/>
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding Metrics}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Reuse}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock x:Name="RunsEmptyText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.6"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- ── Riwayat antrian ── -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LogTitle"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            Padding="16,10" CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LogColWhen"  Grid.Column="0" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="LogColEvent" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="LogColUser"  Grid.Column="2" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock x:Name="LogColNote"  Grid.Column="3" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                        </Grid>
                    </Border>

                    <ItemsRepeater x:Name="LogRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding When}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="{Binding EventTint}"
                                                CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Event}" FontSize="10"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding User}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Role}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       FontSize="10" Opacity="0.5"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Note}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock x:Name="LogEmptyText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Opacity="0.6"
                               Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
