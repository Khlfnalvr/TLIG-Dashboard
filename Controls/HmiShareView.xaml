<UserControl
    x:Class="TLIGDashboard.Controls.HmiShareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderText"
                       Grid.Column="0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.82"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <ComboBox x:Name="SourceSelector"
                      Grid.Column="1"
                      MinWidth="128"
                      MaxWidth="220"
                      Height="28"
                      FontSize="11"
                      SelectionChanged="SourceSelector_SelectionChanged"/>

            <Button x:Name="RefreshSourcesButton"
                    Grid.Column="2"
                    Height="28"
                    MinWidth="68"
                    Padding="10,0"
                    FontSize="11"
                    Click="RefreshSourcesButton_Click"/>

            <Button x:Name="StopShareButton"
                    Grid.Column="3"
                    Height="28"
                    MinWidth="54"
                    Padding="10,0"
                    FontSize="11"
                    Visibility="Collapsed"
                    Click="StopShareButton_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Image x:Name="CaptureImage"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <StackPanel x:Name="PlaceholderPanel"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="18">
                    <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                              Glyph="&#xE7F4;"
                              FontSize="28"
                              Opacity="0.62"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PlaceholderText"
                               FontSize="11"
                               Opacity="0.62"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="280"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: live numeric/text values pushed from LabVIEW over UDP. -->
        <Border x:Name="DataSection"
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="DataLiveDot"
                             Grid.Column="0"
                             Width="8" Height="8"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="DataHeaderText"
                               Grid.Column="1"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.82"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="DataPortText"
                               Grid.Column="2"
                               FontSize="10"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="150">
                    <StackPanel x:Name="DataList" Spacing="2"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
