<UserControl
    x:Class="TLIGDashboard.Controls.ContextRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Width="20" Height="20" VerticalAlignment="Center">
        <Ellipse Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                 StrokeThickness="2" Opacity="0.3"/>
        <Path x:Name="Arc"
              Stroke="{ThemeResource SystemFillColorSuccessBrush}"
              StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <TextBlock x:Name="Pct"
                   FontSize="6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

</UserControl>
