<UserControl
    x:Class="TLIGDashboard.Controls.ChatSessionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="6" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="SessionCombo"
                  Grid.Column="0"
                  FontSize="11" MinWidth="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  SelectionChanged="SessionCombo_SelectionChanged"/>

        <Button Grid.Column="1"
                Width="28" Height="28" Padding="0"
                VerticalAlignment="Center"
                Click="NewBtn_Click"
                ToolTipService.ToolTip="Percakapan baru">
            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                      FontSize="12" Glyph="&#xE710;"/>
        </Button>

        <Button Grid.Column="2"
                Width="28" Height="28" Padding="0"
                VerticalAlignment="Center"
                Click="DeleteBtn_Click"
                ToolTipService.ToolTip="Hapus percakapan ini">
            <FontIcon FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                      FontSize="12" Glyph="&#xE74D;"/>
        </Button>
    </Grid>

</UserControl>
